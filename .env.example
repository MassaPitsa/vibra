# ═══════════════════════════════════════════════════════════════
#  VIBRA — configuración. Copia este archivo como `.env` y rellénalo.
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000
# URL pública final, con https y sin barra al final
SITE_URL=https://www.tudominio.com
SITE_NAME=VIBRA

# Secreto de sesión (OBLIGATORIO en producción, mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Número de proxies delante de la app (1 en Render/Railway/Fly o con Nginx/Cloudflare delante)
TRUST_PROXY=1

# Carpeta persistente para la base de datos y las fotos (en Docker: /data)
DATA_DIR=data

# El usuario que se registre con este email será administrador (panel /admin)
ADMIN_EMAIL=

# ─── Datos legales del titular (LSSI-CE art. 10 y RGPD art. 13) — OBLIGATORIOS ───
LEGAL_OWNER_NAME=
LEGAL_OWNER_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_CONTACT_EMAIL=
# Opcional (sólo sociedades): Registro Mercantil, tomo, folio, hoja…
LEGAL_REGISTRY=
LEGAL_LAST_UPDATE=22 de septiembre de 2026

# ─── Google AdSense (vacío = sin anuncios) ───
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=
# IDs de bloques de anuncios (AdSense > Anuncios > Por bloque de anuncios). Opcionales si usas Anuncios automáticos.
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_LOOK=
# own    = banner de cookies propio + Google Consent Mode v2
# google = CMP certificado de Google (AdSense > Privacidad y mensajes > RGPD). Recomendado para anuncios personalizados en la UE.
CMP_MODE=own

# ─── Email (recuperación de contraseña). Ej.: Brevo, Mailgun, Amazon SES, Zoho… ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VIBRA <no-reply@tudominio.com>"

# ─── Cloudflare Turnstile (anti-bots en registro, opcional y gratuito) ───
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
