# ═══════════════════════════════════════════════════════════════
#  VIBRA — configuración. Copia este archivo como `.env` y rellénalo.
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000
# URL pública final, con https y sin barra al final
SITE_URL=https://www.tudominio.com
SITE_NAME=VIBRA

# Secreto de sesión (OBLIGATORIO en producción, mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Número de proxies delante de la app (1 en Render/Railway/Fly o con Nginx/Cloudflare delante)
TRUST_PROXY=1

# Carpeta para la base de datos y las fotos (en Docker: /data)
DATA_DIR=data

# ─── Almacenamiento de fotos en la nube (S3: Backblaze B2, Cloudflare R2, Wasabi…) ───
# Imprescindible si el hosting NO tiene disco persistente (Render, Northflank, Koyeb…).
# Déjalo vacío para guardar las fotos en el disco del servidor.
#   Backblaze B2 (10 GB gratis, sin tarjeta):
#     S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com   (el que muestre tu bucket)
#     S3_REGION=eu-central-003                                 (la misma región del endpoint)
#   Cloudflare R2 (10 GB gratis, pide tarjeta):
#     S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
#     S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública del bucket (opcional). Si la pones, las fotos se sirven desde el CDN
# del proveedor en lugar de pasar por la app: más rápido y menos consumo.
S3_PUBLIC_BASE_URL=

# Copia automática de la base de datos al bucket, en minutos (0 = desactivada).
# Sólo se usa si hay bucket configurado: protege los datos en hostings que borran el disco.
DB_SYNC_MINUTES=5

# El usuario que se registre con este email será administrador (panel /admin)
ADMIN_EMAIL=

# ─── Datos legales del titular (LSSI-CE art. 10 y RGPD art. 13) — OBLIGATORIOS ───
LEGAL_OWNER_NAME=
LEGAL_OWNER_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_CONTACT_EMAIL=
# Opcional (sólo sociedades): Registro Mercantil, tomo, folio, hoja…
LEGAL_REGISTRY=
LEGAL_LAST_UPDATE=22 de septiembre de 2026

# ─── Google AdSense (vacío = sin anuncios) ───
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=
# IDs de bloques de anuncios (AdSense > Anuncios > Por bloque de anuncios). Opcionales si usas Anuncios automáticos.
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_LOOK=
# own    = banner de cookies propio + Google Consent Mode v2
# google = CMP certificado de Google (AdSense > Privacidad y mensajes > RGPD). Recomendado para anuncios personalizados en la UE.
CMP_MODE=own

# ─── Email (recuperación de contraseña). Ej.: Brevo, Mailgun, Amazon SES, Zoho… ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VIBRA <no-reply@tudominio.com>"

# ─── Cloudflare Turnstile (anti-bots en registro, opcional y gratuito) ───
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
