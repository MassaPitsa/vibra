<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const ticketCover = (covers) => covers.length ? covers.slice(0, 4) : [];
%>
<main id="main">
  <div class="saved-head">
    <div>
      <span class="kicker kicker--accent">Tu front row privado</span>
      <h1 class="display">Guarda<span class="serif accent">dos</span></h1>
    </div>
    <p class="muted" style="max-width:380px;margin:0"><%= totalSaved %> <%= totalSaved === 1 ? 'look guardado' : 'looks guardados' %> · <%= collections.length %> <%= collections.length === 1 ? 'colección' : 'colecciones' %>. Ordena tus guardados en colecciones como quieras.</p>
  </div>

  <nav class="tickets" aria-label="Colecciones">
    <a class="ticket <%= !active ? 'is-active' : '' %>" href="/guardados" <%- !active ? 'aria-current="page"' : '' %>>
      <div class="ticket__cover <%= allCovers.length === 1 ? 'one' : '' %>"><% if (allCovers.length) { allCovers.forEach((t) => { %><img src="/media/<%= t %>" alt="" loading="lazy"><% }) } else { %><span class="ph"><%- icon('bookmark').replace('<svg', '<svg style="width:40px;height:40px"') %></span><% } %></div>
      <div class="ticket__body"><p class="ticket__name">Todos</p><span class="muted mono" style="font-size:11px"><%= totalSaved %> looks</span></div>
      <div class="ticket__stub"><span>Admit all</span><span>Nº 000</span></div>
    </a>
    <% collections.forEach((c, i) => { const cv = ticketCover(c.covers); %>
      <a class="ticket <%= active && active.id === c.id ? 'is-active' : '' %>" href="/guardados?c=<%= c.id %>" <%- active && active.id === c.id ? 'aria-current="page"' : '' %>>
        <div class="ticket__cover <%= cv.length === 1 ? 'one' : '' %>"><% if (cv.length) { cv.forEach((t) => { %><img src="/media/<%= t %>" alt="" loading="lazy"><% }) } else { %><span class="ph"><%= c.name[0].toUpperCase() %></span><% } %></div>
        <div class="ticket__body"><p class="ticket__name"><%= c.name %></p><span class="muted mono" style="font-size:11px"><%= c.count %> looks<%= c.is_public ? ' · pública' : ' · privada' %></span></div>
        <div class="ticket__stub"><span>Admit one</span><span>Nº <%= lookNumber(i + 1) %></span></div>
      </a>
    <% }) %>
    <button type="button" class="ticket ticket--new" data-new-collection>
      <span class="btn-plus" aria-hidden="true">+</span>
      <span class="kicker">Nueva colección</span>
    </button>
  </nav>

  <% if (active) { %>
  <div class="coll-bar" data-coll-bar data-id="<%= active.id %>">
    <h2 class="display" style="font-size:clamp(36px,5vw,64px);margin-right:auto" data-coll-name><%= active.name %></h2>
    <label class="toggle"><input type="checkbox" data-coll-public <%= active.is_public ? 'checked' : '' %>> Pública</label>
    <button type="button" class="btn btn--ghost btn--sm" data-coll-share data-share="/c/<%= active.id %>" data-share-title="<%= active.name %>" <%= active.is_public ? '' : 'hidden' %>><%- icon('link') %> Compartir</button>
    <button type="button" class="btn btn--accent btn--sm" data-open-picker <%= pickable.length ? '' : 'disabled' %>>+ Añadir desde guardados</button>
    <button type="button" class="btn btn--ghost btn--sm" data-coll-rename><%- icon('edit') %> Renombrar</button>
    <button type="button" class="btn btn--danger btn--sm" data-coll-delete><%- icon('trash') %> Borrar</button>
  </div>
  <% } %>

  <section class="section" style="padding-top:18px">
    <% if (items.length) { %>
      <div class="grid"><%- include('partials/cards', { items, removeFrom: active ? active.id : null }) %></div>
    <% } else if (active) { %>
      <div class="empty">
        <p class="display">Colección vacía</p>
        <p><%= pickable.length ? 'Añade looks desde tus guardados para empezar a darle forma.' : 'Primero guarda looks del feed; luego podrás meterlos aquí.' %></p>
        <% if (pickable.length) { %><button type="button" class="btn btn--accent" data-open-picker>Añadir desde guardados</button><% } else { %><a class="btn btn--accent" href="/">Ir al feed</a><% } %>
      </div>
    <% } else { %>
      <div class="empty">
        <p class="display">Nada guardado aún</p>
        <p>Pulsa el marcador en cualquier look para guardarlo aquí. Después organízalos en colecciones: «Invierno», «Para copiar», «Grails»…</p>
        <a class="btn btn--accent" href="/">Explorar looks <span class="arrow">→</span></a>
      </div>
    <% } %>
  </section>
</main>

<% if (active) { %>
<div class="modal" data-picker aria-hidden="true">
  <div class="modal__backdrop" data-close></div>
  <form class="modal__panel modal__panel--wide" role="dialog" aria-modal="true" aria-labelledby="picker-title" data-picker-form>
    <div class="modal__head">
      <h2 id="picker-title">Añadir a «<%= active.name %>»</h2>
      <button type="button" class="icon-btn" data-close aria-label="Cerrar"><%- icon('close') %></button>
    </div>
    <div class="picker">
      <% pickable.forEach((l) => { if (!l.cover) return; %>
        <label><input type="checkbox" name="add" value="<%= l.id %>"><img src="/media/<%= l.cover.thumb %>" alt="<%= l.title %>" loading="lazy"><span class="ck" aria-hidden="true"></span></label>
      <% }) %>
    </div>
    <div class="picker-foot">
      <span class="kicker" data-picker-count>0 seleccionados</span>
      <button class="btn btn--accent" type="submit">Añadir a la colección</button>
    </div>
  </form>
</div>
<% } %>
<%- include('partials/footer') %>
