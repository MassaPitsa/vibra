<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main" class="error-page">
  <div>
    <p class="display glitch" data-text="<%= status %>" aria-hidden="true"><%= status %></p>
    <h1 class="display" style="font-size:clamp(32px,5vw,64px);margin:20px 0 12px"><%= status === 404 ? 'Look no encontrado' : status === 429 ? 'Frena un poco' : status >= 500 ? 'Caos en el backstage' : 'Algo no cuadra' %></h1>
    <p class="muted" style="max-width:460px;margin:0 auto 28px"><%= message %></p>
    <a class="btn btn--accent" href="/">Volver a la pasarela <span class="arrow">→</span></a>
  </div>
</main>
<%- include('partials/footer') %>
