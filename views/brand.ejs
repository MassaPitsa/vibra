<%
  const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${brand.name} en la calle`,
    url: `${config.siteUrl}/marca/${brand.slug}`,
    about: { '@type': 'Brand', name: brand.name },
    inLanguage: 'es',
  };
%>
<%- include('partials/head', { jsonLd }) %>
<%- include('partials/header') %>
<main id="main">
  <header class="profile-head">
    <div class="profile-head__bg" aria-hidden="true"><%= brand.name %> <%= brand.name %></div>
    <div class="profile-head__row">
      <div style="flex:1;min-width:240px">
        <span class="kicker kicker--accent"><a href="/marcas" style="color:inherit">Marcas</a> · street report</span>
        <h1 class="display"><%= brand.name %></h1>
        <p class="profile-head__bio">Cómo se lleva <%= brand.name %> de verdad, según <%= stats.people %> <%= stats.people === 1 ? 'persona' : 'personas' %> de la comunidad.</p>
      </div>
      <a class="btn btn--accent btn--sm" href="/subir">Sube tu look con <%= brand.name %></a>
    </div>
    <div class="profile-stats">
      <div class="stat"><b><%= compact(stats.looks) %></b><span>Looks</span></div>
      <div class="stat"><b><%= compact(stats.people) %></b><span>Personas</span></div>
    </div>
  </header>

  <section class="section">
    <% if (items.length) { %>
      <div class="grid" data-grid><%- include('partials/cards', { items }) %></div>
      <% if (hasMore) { %><p style="text-align:center;margin-top:30px"><a class="btn btn--ghost" href="?page=<%= page + 1 %>">Más looks con <%= brand.name %></a></p><% } %>
    <% } else { %>
      <div class="empty"><p class="display">Sin looks</p><p>Todavía nadie ha publicado un outfit con esta marca.</p><a class="btn btn--accent" href="/subir">Ser el primero</a></div>
    <% } %>
  </section>

  <% if (related.length) { %>
  <section class="section" style="padding-top:0">
    <div class="section__head"><h2 class="kicker">Otras marcas de la comunidad</h2></div>
    <div class="brand-cloud">
      <% related.forEach((b) => { %><a class="brand-chip" href="/marca/<%= b.slug %>" style="--w: 1"><span><%= b.name %></span><i><%= b.n %></i></a><% }) %>
    </div>
  </section>
  <% } %>
</main>
<%- include('partials/footer') %>
