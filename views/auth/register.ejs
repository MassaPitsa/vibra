<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="auth">
  <section class="auth__poster" data-tilt-area>
    <span class="kicker kicker--accent">Casting abierto · FW26</span>
    <p class="display">La calle<br><span class="serif accent">también</span><br>tiene su<br>pasarela</p>
    <div class="pass" data-tilt aria-hidden="true">
      <div class="pass__top"><span>Backstage</span><span>FW26</span></div>
      <div>
        <div class="pass__big">All<br>access</div>
        <div class="pass__name" data-pass-name>@<%= form.username || 'tu_usuario' %></div>
      </div>
      <div class="pass__bar"></div>
      <div class="pass__strip">Model · <%= config.siteName %></div>
    </div>
  </section>
  <section class="auth__form">
    <h1 class="display">Crea tu pase</h1>
    <p class="muted" style="margin:0 0 28px">Gratis. Sin invitación. Sólo necesitas estilo.</p>
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <%- include('../partials/google-btn', { next }) %>
    <form method="post" action="/registro" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="hp" aria-hidden="true"><label for="website">No rellenes este campo</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
      <div class="field"><label for="username">Usuario</label><input id="username" name="username" required minlength="3" maxlength="24" pattern="[a-z0-9._]{3,24}" autocomplete="username" autocapitalize="none" spellcheck="false" value="<%= form.username || '' %>" data-username><small>3-24 caracteres: minúsculas, números, «.» o «_».</small></div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email" value="<%= form.email || '' %>"></div>
      <div class="field"><label for="password">Contraseña</label><input id="password" name="password" type="password" required minlength="10" autocomplete="new-password"><small>Mínimo 10 caracteres.</small></div>
      <div class="field"><label for="password2">Repite la contraseña</label><input id="password2" name="password2" type="password" required autocomplete="new-password"></div>
      <label class="check"><input type="checkbox" name="age" required> <span>Tengo <strong>14 años o más</strong>.</span></label>
      <label class="check"><input type="checkbox" name="terms" required> <span>Acepto los <a href="/legal/terminos" target="_blank">Términos y condiciones</a> y las <a href="/legal/normas" target="_blank">Normas de la comunidad</a>, y he leído la <a href="/legal/privacidad" target="_blank">Política de privacidad</a>.</span></label>
      <% if (config.turnstile.siteKey) { %><div class="cf-turnstile" data-sitekey="<%= config.turnstile.siteKey %>" data-theme="dark" style="margin:10px 0"></div><script nonce="<%= nonce %>" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
      <button class="btn btn--accent btn--block" type="submit" style="margin-top:10px">Entrar al casting <span class="arrow">→</span></button>
      <p class="muted" style="font-size:12px;margin-top:14px">Responsable: <%= config.legal.ownerName || config.siteName %>. Finalidad: gestionar tu cuenta y tu contenido. Base: contrato. No cedemos tus datos salvo obligación legal. Derechos: acceso, rectificación, supresión y más en la <a class="link-u" href="/legal/privacidad">Política de privacidad</a>.</p>
    </form>
    <p class="auth__alt">¿Ya tienes pase? <a class="link-u" href="/entrar<%= next !== '/' ? '?next=' + encodeURIComponent(next) : '' %>">Entrar</a></p>
  </section>
</main>
<%- include('../partials/footer') %>
