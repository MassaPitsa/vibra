<% items.forEach((look) => { const c = look.cover; if (!c) return; %>
<section class="slide" data-slide data-look="<%= look.id %>" aria-label="Look Nº <%= lookNumber(look.id) %>: <%= look.title %>">
  <div class="slide__bg" style="background-image:url('<%= media(c.thumb) %>')" aria-hidden="true"></div>
  <img class="slide__img" src="<%= media(c.file) %>" width="<%= c.w %>" height="<%= c.h %>" alt="<%= look.title %> — outfit de @<%= look.username %>" loading="lazy" decoding="async">
  <div class="slide__info">
    <span class="kicker kicker--accent">Look Nº <%= lookNumber(look.id) %><% if (look.city) { %> · <%= look.city %><% } %></span>
    <h2 class="display"><%= look.title %></h2>
    <% if (look.description) { %><p><%= look.description %></p><% } %>
    <a href="/u/<%= look.username %>" class="kicker" style="color:var(--paper)">@<%= look.username %></a>
  </div>
  <div class="slide__rail">
    <div>
      <button type="button" class="save-btn" data-save="<%= look.id %>" data-count-target aria-pressed="<%= look.saved ? 'true' : 'false' %>" aria-label="<%= look.saved ? 'Quitar de guardados' : 'Guardar look' %>">
        <%- icon('bookmark') %><span class="burst" aria-hidden="true"><% for (let k = 0; k < 8; k++) { %><i style="--a: <%= k * 45 %>deg"></i><% } %></span>
      </button>
      <small data-count="<%= look.id %>"><%= compact(look.save_count) %></small>
    </div>
    <div><button type="button" class="icon-btn" data-collect="<%= look.id %>" aria-label="Añadir a colección"><%- icon('folder') %></button><small>Colección</small></div>
    <div><button type="button" class="icon-btn" data-share="/look/<%= look.id %>" data-share-title="<%= look.title %>" aria-label="Compartir"><%- icon('share') %></button><small>Compartir</small></div>
    <div><a class="icon-btn" href="/look/<%= look.id %>" aria-label="Ver detalles del look"><%- icon('expand') %></a><small>Detalle</small></div>
  </div>
</section>
<% }) %>
